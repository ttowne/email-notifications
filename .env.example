# Kafka
KAFKA_BROKERS=broker1:9092,broker2:9092,broker3:9092
KAFKA_GROUP_ID=email-notifications
KAFKA_INPUT_TOPIC=search.results.notification
KAFKA_STATE_UPDATES_TOPIC=notification.state.updates
KAFKA_EMAIL_OUTBOUND_TOPIC=email.outbound

# URLs
RESULT_LINK_BASE_URL=https://app.example.com/documents
NOTIFICATION_SETTINGS_URL=https://app.example.com/settings/notifications

# Cassandra (uncomment when document service is wired up)
# CASSANDRA_HOSTS=cassandra-host:9042
# CASSANDRA_KEYSPACE=app
